<?xml version="1.0" encoding="utf-8"?>
<!--
  阅读器布局（参考主流阅读 App 的沉浸式设计）

  层次：
  1. ViewPager 铺满全屏，正文永远占满可用空间
  2. 顶部/底部工具栏是「覆盖」在正文之上的浮层，显示/隐藏不改变正文尺寸，
     避免控制栏出现时分页结果被挤压重算
  3. 页脚只保留极简的页码/时间/电量
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reader_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_bg"
    tools:context=".ui.reader.ReaderActivity">

    <!-- 正文：铺满全屏 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager_reader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal" />

    <!-- 极简页脚：始终可见，压在正文底部 -->
    <TextView
        android:id="@+id/text_reader_footer"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:textColor="@color/reader_text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:background="@color/reader_bg"
        tools:text="1/12  ·  12:00  ·  85%" />

    <!-- 章节名 / 临时状态：底部细条，默认隐藏 -->
    <TextView
        android:id="@+id/text_chapter_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/reader_text_secondary"
        android:textSize="11sp"
        android:background="@color/reader_bg"
        android:visibility="gone"
        tools:text="第一章 巡检司" />

    <!-- 顶部工具栏浮层：默认隐藏 -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/reader_bar_gradient_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/reader_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_add_shelf"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/add_shelf"
            android:textColor="@color/reader_text"
            android:textSize="12sp"
            android:background="@drawable/reader_chip_background"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_download"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/download"
            android:textColor="@color/reader_text"
            android:textSize="12sp"
            android:background="@drawable/reader_chip_background"
            android:clickable="true"
            android:focusable="true" />

        <FrameLayout
            android:id="@+id/layout_comment"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_comment"
                android:tint="@color/reader_text" />

            <TextView
                android:id="@+id/text_comment_badge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="2dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/badge_background"
                android:gravity="center"
                android:minWidth="16dp"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="2" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share"
            android:tint="@color/reader_text" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/reader_text" />
    </LinearLayout>

    <!-- 底部工具栏浮层：默认隐藏，圆角卡片上浮 -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/reader_toolbar_background"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 章节进度行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btn_prev_chapter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/prev_chapter"
                android:textColor="@color/reader_text_secondary"
                android:textSize="11sp"
                android:background="@drawable/reader_chip_background"
                android:clickable="true"
                android:focusable="true" />

            <SeekBar
                android:id="@+id/seekbar_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:max="100"
                android:progress="0"
                style="@style/Widget.AppCompat.SeekBar" />

            <TextView
                android:id="@+id/btn_next_chapter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/next_chapter"
                android:textColor="@color/reader_text_secondary"
                android:textSize="11sp"
                android:background="@drawable/reader_chip_background"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_page_info"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center"
            android:textColor="@color/reader_text_secondary"
            android:textSize="10sp"
            tools:text="第 3 章 / 共 572 章" />

        <!-- 三个主功能：大图标 + 小字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_catalog"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_catalog"
                    android:tint="@color/reader_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/catalog"
                    android:textColor="@color/reader_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_night_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_night"
                    android:tint="@color/reader_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/night_mode"
                    android:textColor="@color/reader_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/reader_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/settings"
                    android:textColor="@color/reader_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 加载中 -->
    <LinearLayout
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/loading"
            android:textColor="@color/reader_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 目录抽屉遮罩 -->
    <View
        android:id="@+id/scrim_catalog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- 目录抽屉面板 -->
    <LinearLayout
        android:id="@+id/layout_catalog_sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_sheet_background"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="8dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/reader_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/catalog"
                android:textColor="@color/reader_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_catalog_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/reader_text_secondary"
                android:rotation="90" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/reader_bottom_bar_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_catalog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

</FrameLayout>
